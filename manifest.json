{
  "manifest_version": 3,
  "name": "BlattamToby",
  "version": "1.0.0",
  "description": "BlattamToby — менеджер сохранённых вкладок",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+T"
      },
      "description": "Открыть сохранённые вкладки (BlattamToby)"
    }
  }
}
