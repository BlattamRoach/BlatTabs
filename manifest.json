{
  "manifest_version": 3,
  "name": "BlattamToby",
  "version": "1.0.0",
  "description": "BlattamToby — менеджер сохранённых вкладок",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+T"
      },
      "description": "Открыть сохранённые вкладки (BlattamToby)"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["chrome-extension://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
