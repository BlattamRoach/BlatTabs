{
  "manifest_version": 3,
  "name": "BlatTabs",
  "version": "1.0.0",
  "description": "BlatTabs — менеджер сохранённых вкладок",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "save-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Сохранить текущую вкладку"
    }
  },
  "chrome_url_overrides": {
    "newtab": "view.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
