{
  "manifest_version": 3,
  "name": "BlattamToby",
  "version": "1.0.0",
  "description": "BlattamToby — менеджер сохранённых вкладок",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "view.html"
  }
}
